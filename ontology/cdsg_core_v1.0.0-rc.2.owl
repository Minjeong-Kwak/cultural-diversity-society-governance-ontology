  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/alternative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentIssuerRole">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document issuer role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#DocumentActorRole"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b1"/>
    <skos:definition xml:lang="en">The anti-rigid role of an institutional actor that issues a policy document.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#module">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">module</rdfs:label>
  </rdf:Description>
