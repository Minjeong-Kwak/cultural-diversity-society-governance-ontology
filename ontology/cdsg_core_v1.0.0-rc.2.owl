    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isExpressedIn"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentReferencePeriodAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document reference period assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <skos:definition xml:lang="en">A conservative temporal qualification associating a policy document with a reference or edition period when the evidence does not warrant interpreting that period as validity, planning horizon, or reporting coverage.</skos:definition>
    <cdsg:module>temporal</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/modified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b31">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b32"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b42">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b44"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#specializationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasEnd">
