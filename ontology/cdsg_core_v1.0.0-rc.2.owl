    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b28">
    <rdf:first rdf:nodeID="nb32976c56be042cfa8637a118145dd67b26"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
