<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:cdsg="https://w3id.org/cdsg/core#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:gufo="http://purl.org/nemo/gufo#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#NonSortal"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyTargetRole"/>
    <skos:definition xml:lang="en">A higher-order type used to classify endurants as belonging to a policy-relevant category. A policy target category is distinct from a definition or rule that specifies its criteria, from any concrete bearer falling under it, and from the anti-rigid policy-target role a bearer may acquire in a policy context.</skos:definition>
    <cdsg:designRationale xml:lang="en">Source-specified target categories and research-curated comparison categories are distinct resources. Category-level targeting does not entail that any concrete bearer has actually received a policy intervention. The instances of PolicyTargetCategory are categories, which classify endurants; the instances of PolicyTargetRole are endurants in a target role. A category is not an endurant in a role, so the two are disjoint.</cdsg:designRationale>
    <cdsg:module>target</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#operationalizesTargetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">operationalizes target category</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
    <skos:definition xml:lang="en">Links an operationalization statement to the source-specified category whose membership criteria it operationalizes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyContent">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy content</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#AbstractIndividual"/>
    <skos:definition xml:lang="en">An abstract information content item expressed in one or more policy documents. It can be a prescription, goal, definition, recommendation, or descriptive assertion, but is not itself the document that bears it.</skos:definition>
    <cdsg:designRationale xml:lang="en">Policy content is aligned to gufo:AbstractIndividual because it is propositional content: the same specification, definition or assertion can be expressed in several documents and versions, and its identity does not depend on any physical inscription. The document that expresses it is a separate gufo:Object linked by isExpressedIn.</cdsg:designRationale>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TargetPopulationOperationalizationStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">target population operationalization statement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
    <skos:definition xml:lang="en">A source statement identifying indicators, dimensions, or measurement variables for operationalizing a target-population construct without fixing the extension of one single policy target category.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. A population operationalization names indicators or variables for a construct without fixing the extension of one category, which separates it from an explicit definition and from the operationalization of one category.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#GovernmentOrganization">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">government organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#Organization"/>
    <skos:definition xml:lang="en">An organization belonging to a governmental or public-administration structure. This is a rigid organizational subkind, not a temporary policy role.</skos:definition>
    <cdsg:module>actor</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetRole">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy target role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <skos:definition xml:lang="en">An anti-rigid relational role borne by a concrete endurant because policy content places it among the targets of a policy, directly or through a target category it falls under. It is distinct from the target category itself, and membership in a category does not by itself entail the role.</skos:definition>
    <cdsg:designRationale xml:lang="en">Policy target roles and institutional actor roles are relational types founded on the designation expressed in policy content: a bearer instantiates the role type because policy content names it, or a category it falls under, in that capacity. CDSG does not introduce gUFO relators for these designations; where the founding relation is stated, it is the object property in the role's equivalence axiom. The core declares the policy target role without such an axiom because this release records target categories, not individual bearers. The policy-process extension defines the direct target role by isDirectTargetOf and leaves the category-mediated target role to an explicit membership assertion. An actor that instantiates a role type is not thereby reclassified in its kind.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <skos:definition xml:lang="en">Policy content that asserts or reports that some policy-relevant state of affairs, event, status, or outcome obtains or obtained. An assertion is distinct from the situation or event it describes.</skos:definition>
    <cdsg:module>provenance</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">explicit target category definition</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b40"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement"/>
    <skos:definition xml:lang="en">A source statement that explicitly states extension criteria for a single target category using definitional content such as “means”, “is”, or an equivalent criterion.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. An explicit definition states the extension criteria of one category; a classification scheme, a constitution rule, an operationalization and a terminology statement do not, so they are kept apart from it.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidenceSourceFileName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">evidence source file name</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The file name recorded by the curated dataset for the source document used by an evidence record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b16"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#supersededDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">superseded document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#DocumentSupersessionAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <skos:definition xml:lang="en">Identifies the earlier document that, according to the source, is replaced.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">operationalized policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b25"/>
    <skos:definition xml:lang="en">A source-specified policy target category whose membership criteria are operationalized for statistical or administrative use rather than presented as a legal definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Follows from the disjointness of operationalizations and constitution rules and from the single specifying statement of a source-specified category.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/org#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#Organization">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#GovernmentPost"/>
    <skos:definition xml:lang="en">A socially constituted functional complex with an organizational identity that persists through changes in members, office holders, and many internal arrangements.</skos:definition>
    <cdsg:designRationale xml:lang="en">An organization is a functional complex whose identity persists through changes of members and office holders; a government post is a position within an organization that persists through changes of its holder. They are different kinds, so neither can be the other, and reasoning from a post's document roles must not reclassify it as an organization; an inconsistency fixture tests this.</cdsg:designRationale>
    <cdsg:module>actor</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">target category classification-scheme statement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement"/>
    <skos:definition xml:lang="en">A source statement specifying a classification scheme, classification dimensions, or a set of categories without defining a single policy target category represented as one OWL class.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. A classification scheme statement lays out a set of categories or dimensions without fixing one category, which separates it from a definition and from a statement that only fixes or reports a term.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b34">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b36"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasJurisdictionEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has jurisdiction evidence</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <skos:definition xml:lang="en">Links a jurisdiction individual to evidence supporting its identification or classification in the curated corpus.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasIdentityEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has identity evidence</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <skos:definition xml:lang="en">Links an institutional actor to evidence supporting its identification or institutional classification in the curated corpus.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentCoveragePeriodAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document coverage period assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <skos:definition xml:lang="en">A temporal qualification stating the period covered by a reporting document when the source explicitly presents the interval as a reporting or coverage period.</skos:definition>
    <cdsg:module>temporal</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b38">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#constitutesTargetCategory"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">target category constitution rule</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b38"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#NormativeContent"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <skos:definition xml:lang="en">Normative content that establishes how membership in or acquisition of a policy-relevant legal status or category comes about. It is not conflated with a lexical category definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage, and a passage that performs two functions is recorded as two statements. A constitution rule creates a category's status by legal force; a definition states criteria for a term and an operationalization gives criteria without legal force, so the three are kept apart.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocument">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normative document</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b24"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <skos:definition xml:lang="en">A policy document whose institutional status gives normative force to at least some content it expresses, such as a statute, regulation, executive order, or formal administrative decision.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#definesTargetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">defines target category</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
    <skos:definition xml:lang="en">Links an explicit source definition to the source-defined policy target category whose extension criteria it states.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidenceText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">evidence text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:definition xml:lang="en">Records source text or an evidential excerpt supporting the assertion represented by an evidence record.</skos:definition>
    <cdsg:designRationale xml:lang="en">Each evidence record supports one claim and carries one verbatim excerpt; fragments from the same page are joined with ' … '.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasInstitutionalActorType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has institutional actor classification</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Organization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Links an organization to its institutional type in the controlled institutional actor type scheme; the classification is not treated as an ontological identity condition.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#evidenceDocument"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#hasBeginning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">statistical target category definition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
    <skos:definition xml:lang="en">An explicit target-category definition used by a statistical authority or standard and not represented as a normatively constitutive legal definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Normative and statistical definitions are told apart by the institutional status of the source: a definition carries institutional force in a jurisdiction or it does not. See NormativeTargetCategoryDefinition.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidencePage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">evidence page</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Records a page or page-range locator supplied for a source-evidence record.</skos:definition>
    <cdsg:designRationale xml:lang="en">Functional from rc.2: each evidence record supports one claim and cites one page or page range of one file. Evidence taken from a web page has no page and is located by its address instead.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasSourceEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has source evidence</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <skos:definition xml:lang="en">Links policy content or an assertion to a provenance record that identifies supporting documentary evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is specified by target-category statement</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
    <skos:definition xml:lang="en">Inverse of specifies target category.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b11">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b17">
    <rdf:first rdf:nodeID="nb32976c56be042cfa8637a118145dd67b15"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentActorRole">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document actor role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#InstitutionalActorRole"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b18"/>
    <skos:definition xml:lang="en">A relational role borne by an institutional actor because it stands in an issuance or publication relation to a policy document.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b12">
    <rdf:first rdf:nodeID="nb32976c56be042cfa8637a118145dd67b10"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#issuesPolicyDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">issues policy document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#issuedByInstitutionalActor"/>
    <skos:definition xml:lang="en">Inverse of issued by institutional actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b53">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b52"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocumentVersion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normative document version</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b41"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <skos:definition xml:lang="en">A published text state of a normative document: the original text as made or published, or an official consolidation that incorporates amendments up to a stated point. Each version is a version of exactly one normative document, and a source statement is cited from a version.</skos:definition>
    <cdsg:designRationale xml:lang="en">A normative document keeps its identity while it is amended, so it is modelled as a gufo:Object whose text changes over time. The definition a source statement cites belongs to one fixed text state. The version is a separate gufo:Kind, disjoint with PolicyDocument, so that document identity, text state and propositional content are not conflated. isVersionOf specializes prov:specializationOf, the PROV relation for a more specific state of an entity. Dates are recorded only as the publisher states them; no in-force date is inferred.</cdsg:designRationale>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#publisherURI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">publisher URI</rdfs:label>
    <rdfs:domain rdf:nodeID="nb32976c56be042cfa8637a118145dd67b13"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <skos:definition xml:lang="en">The persistent web address under which the publisher makes the document or version available, such as a European Legislation Identifier (ELI) or a law database address. Recorded only where the source prints it or the address was confirmed at the publisher.</skos:definition>
    <cdsg:designRationale xml:lang="en">Publisher addresses are kept as xsd:anyURI literals rather than as individuals linked by owl:sameAs: an ELI or law-database address names the publisher's resource, whose identity criteria are the publisher's, and asserting identity would import them. ELI distinguishes the legal resource from its expressions; CDSG records the address at the matching level, on the normative document or on the cited version.</cdsg:designRationale>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b44">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b45"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#publisherIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">publisher identifier</rdfs:label>
    <rdfs:domain rdf:nodeID="nb32976c56be042cfa8637a118145dd67b13"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
    <skos:definition xml:lang="en">An identifier the publisher assigns to the document or version and prints in it or in its official citation, such as an official citation, a law number, a Federal Register document number, an ISBN or a catalogue number. Recorded as it appears in the source.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">source-defined policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b42"/>
    <skos:definition xml:lang="en">A source-specified policy target category whose extension is stated through an explicit category definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Source-specified categories are individuated by the statement that specifies them: the migration-background category of MighEV section 6 and that of the Federal Statistical Office variant 1.1 are two categories. A source-specified category has at most one specifying statement, so the disjointness of the statement types carries over to the category types. A category that a source defines is therefore not one that a source constitutes or operationalizes; a fixture tests that a category given two specifying statements of different types is inconsistent.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#qualifiesPolicyDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">qualifies policy document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#temporallyQualifies"/>
    <skos:definition xml:lang="en">Temporal qualification of a policy document.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#supersessionEffectiveFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">supersession effective from</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#DocumentSupersessionAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">The date from which the source states that the replacement takes effect.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasGovernmentPost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has government post</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Organization"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#GovernmentPost"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#postInOrganization"/>
    <skos:definition xml:lang="en">Inverse of post in organization.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b53"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasTemporalInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has temporal interval</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <skos:definition xml:lang="en">Identifies the interval used by a temporal qualification assertion. The interval itself is represented using OWL-Time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b7">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#supersededDocument"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b20"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b37">
    <rdf:first rdf:nodeID="nb32976c56be042cfa8637a118145dd67b35"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#postInOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">post in organization</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#GovernmentPost"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Organization"/>
    <skos:definition xml:lang="en">Relates a government post to the organization in which the source models that post as institutionally located.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">statistically defined policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b14"/>
    <skos:definition xml:lang="en">A source-defined policy target category whose extension criteria are stated in a statistical standard or statistical definition rather than constituted by a normative rule.</skos:definition>
    <cdsg:designRationale xml:lang="en">Follows from the disjointness of normative and statistical definitions and from the single specifying statement of a source-specified category.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b43">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b50">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#hasSourceEvidence"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy target category statement</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b48"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b49"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b50"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <skos:definition xml:lang="en">Source-expressed policy content concerning the criteria, constitution, operationalization, classification, or terminology of policy target categories. Subclasses distinguish these different semantic functions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasDocumentActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has document actor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isDocumentActorFor"/>
    <skos:definition xml:lang="en">General relation from a policy document to an institutional actor standing in a document-level role.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#appliesInJurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">applies in jurisdiction</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
    <skos:definition xml:lang="en">Identifies a jurisdiction in which the policy content is intended to have application or interpretive relevance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#InstitutionalActor">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">institutional actor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    <skos:definition xml:lang="en">An identity-bearing institutional entity that can be referred to in policy or document relations. In CDSG this category presently covers organizations and institutionally constituted government posts; it is not itself a policy role.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#versionCurrentTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">version current to</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">The date up to which the publisher states that a consolidation is current.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#preparedByInstitutionalActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">prepared by institutional actor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
    <skos:definition xml:lang="en">Identifies the institutional actor that the source names as having prepared the document for its issuer.</skos:definition>
    <cdsg:module>actor</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b46">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#hasTemporalInterval"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isExpressedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is expressed in</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#expressesContent"/>
    <skos:definition xml:lang="en">Links abstract policy content to a document that expresses it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isDefinedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is defined by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#definesTargetCategory"/>
    <skos:definition xml:lang="en">Inverse of defines target category.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b8">
    <rdf:first rdf:nodeID="nb32976c56be042cfa8637a118145dd67b6"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#EvidenceRecord">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">evidence record</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b51"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#AbstractIndividual"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">An abstract provenance record identifying the documentary source and location used to support a policy-content assertion in the knowledge graph. The evidence record is not the source document itself.</skos:definition>
    <cdsg:designRationale xml:lang="en">An evidence record is aligned to gufo:AbstractIndividual because it is an information entity of the knowledge graph that identifies a document, locator and excerpt; it is not the document and has no location or physical identity of its own.</cdsg:designRationale>
    <cdsg:module>provenance</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TemporalQualificationAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temporal qualification assertion</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b46"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b47"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyAssertion"/>
    <skos:definition xml:lang="en">A source-relative assertion that qualifies a policy-relevant item with a temporal interval. It reifies the qualification so that the semantic kind of time relation, the interval, the qualified item, and provenance can be represented separately.</skos:definition>
    <cdsg:module>temporal</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#temporallyQualifies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">temporally qualifies</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <skos:definition xml:lang="en">Identifies the single resource whose temporal qualification is asserted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isOperationalizedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#issuedByInstitutionalActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">issued by institutional actor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
    <skos:definition xml:lang="en">Relates a policy document to the institutional actor explicitly identified as issuing it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyDocument">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">policy document</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <skos:definition xml:lang="en">A socially recognized information-bearing document used to formulate, mandate, explain, evaluate, or report public policy. The document is distinct from the abstract policy content that it expresses.</skos:definition>
    <cdsg:designRationale xml:lang="en">A policy document keeps its identity while its text is amended, republished or consolidated, so it is a gufo:Object of its own kind. The definitions, rules and measures it contains are policy content, modelled separately as abstract individuals and linked to the document by isExpressedIn.</cdsg:designRationale>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#versionInForceFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">version in force from</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">The date from which the publisher states that the text of this version applies. For an original text it is the date of entry into force or signature the source states; for a consolidation it is the in-force date of the latest incorporated amendment.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">CDSG Core Ontology</rdfs:label>
    <dcterms:conformsTo rdf:resource="http://purl.org/nemo/gufo#/1.0.0"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-12</dcterms:created>
    <dcterms:description xml:lang="en">Release candidate 2 core ontology for the Cultural Diversity Society Governance (CDSG) ontology. It formalizes distinctions among policy content, documentary artifacts, institutional actors and roles, target categories and roles, source-relative assertions, situations, provenance, and qualified temporal and normative context.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
    <dcterms:title xml:lang="en">Cultural Diversity Society Governance Core Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>cdsg</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/cdsg/core#</vann:preferredNamespaceUri>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <owl:versionIRI rdf:resource="https://w3id.org/cdsg/core/1.0.0-rc.2"/>
    <owl:versionInfo>1.0.0-rc.2</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#Instant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#retrievedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">retrieved on</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:definition xml:lang="en">The time at which the cited file was retrieved, recorded only where the file itself states it, such as a browser print header or a generation stamp.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/language">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normatively constituted policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b29"/>
    <skos:definition xml:lang="en">A source-specified policy target category whose membership or status is constituted by a normative rule rather than merely described by a lexical definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Follows from the disjointness of constitution rules from definitions and operationalizations and from the single specifying statement of a source-specified category.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#documentReferenceYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">document reference year</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">A reference, edition, or reporting year attached to a policy document. It is distinct from issue date, effective date, and explicit multi-year coverage or planning intervals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentSupersessionAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document supersession assertion</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b22"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b23"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyAssertion"/>
    <skos:definition xml:lang="en">A source-relative assertion that a later document replaces an earlier one, so that the definitions or classifications the later document expresses take the place of those in the earlier document. It is recorded only where a source states the replacement.</skos:definition>
    <cdsg:designRationale xml:lang="en">Three changes to a source statement are kept apart. Replacement: a later source states that it replaces or supersedes an earlier document (the 2024 revision of OMB SPD 15 replacing the 1997 standards). Revocation without replacement: a document's effective period ends and the ending document is recorded with periodEndedByNormativeDocument (Executive Order 13166, revoked by Executive Order 14224). Introduction of a parallel definition: a new concept is added while the old one stays in use (the Federal Statistical Office's immigration history, introduced as an additional data offer while migration-background results continue to be published); no relation is asserted. Replacement is reified because the source that states it, the evidence and the date from which it takes effect belong to the claim, not to either document.</cdsg:designRationale>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TargetCategoryOperationalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">target category operationalization</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b39"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
    <skos:definition xml:lang="en">A source statement giving operational criteria used to delimit membership in a single policy-relevant target category without treating those criteria as a legal definition.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. An operationalization gives measurement or administrative criteria for one category without legal force; a constitution rule creates the category's status by legal force, so the two are kept apart.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#versionIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">version identifier</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:definition xml:lang="en">The citation, revision identifier or consolidation statement by which the publisher identifies the version, recorded as it appears in the source.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#GovernmentPost">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">government post</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Post"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <skos:definition xml:lang="en">A socially instituted government office or position that persists independently of the particular office holder, such as a ministerial or commissioner post.</skos:definition>
    <cdsg:designRationale xml:lang="en">A government post is a position within an organization that persists through changes of its holder; an organization is a functional complex. They are different kinds; see Organization.</cdsg:designRationale>
    <cdsg:module>actor</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b41">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isVersionOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b47">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#temporallyQualifies"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b36">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b37"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDocumentActorFor"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeContent">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normative content</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <skos:definition xml:lang="en">Policy content that has normative force in virtue of an institutional source and context.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidenceSourceURI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">evidence source URI</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <skos:definition xml:lang="en">The web address of the page on which the evidence location occurs, for evidence taken from a web source rather than a file in the corpus. Such a record carries the retrieval time.</skos:definition>
    <cdsg:module>provenance</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#publishedByInstitutionalActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">published by institutional actor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
    <skos:definition xml:lang="en">Relates a policy document to the institutional actor explicitly identified as publishing it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeTargetCategoryDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normative target category definition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#NormativeContent"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition"/>
    <skos:definition xml:lang="en">An explicit target-category definition that is also normative content with institutional force in a jurisdiction.</skos:definition>
    <cdsg:designRationale xml:lang="en">Normative and statistical definitions are told apart by the institutional status of the source, not by its purpose: a definition carries institutional force in a jurisdiction or it does not. The MighEV definition of migration background serves statistics but is issued as an ordinance, so it is normative; the Federal Statistical Office definition of immigration history has no such force, so it is statistical.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#versionKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">version kind</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Classifies a normative document version as an original text or an official consolidation, using the document version kind scheme.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">target category terminology statement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <skos:definition xml:lang="en">A source statement about the terminology used for one or more population or target categories, without itself fixing the extension of a single target category.</skos:definition>
    <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage, and a passage that performs two functions is recorded as two statements. A terminology statement fixes or reports the term used for a category without stating its extension, which separates it from a definition and from a classification scheme.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidenceDocumentVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidence document version</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <skos:definition xml:lang="en">Identifies the version of a normative document in which the evidence location occurs.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#Jurisdiction">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    <skos:definition xml:lang="en">An identity-bearing legally or institutionally constituted domain of authority used to qualify the applicability, observation, or target context of policy information. Federal, national, subnational, and supranational levels are treated as controlled classifications rather than distinct ontological kinds.</skos:definition>
    <cdsg:module>context</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeEffectivePeriodAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normative effective period assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <skos:definition xml:lang="en">A source-relative temporal qualification stating an effective or applicability interval for a normative document. It is distinct from the document's issue date and should be used only when the source warrants an effectiveness interpretation.</skos:definition>
    <cdsg:module>temporal</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isConstitutedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is constituted by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#constitutesTargetCategory"/>
    <skos:definition xml:lang="en">Inverse of constitutes target category.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#publishesPolicyDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">publishes policy document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#publishedByInstitutionalActor"/>
    <skos:definition xml:lang="en">Inverse of published by institutional actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b27"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/conformsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#supersedingDocument"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#hasJurisdictionLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has jurisdiction level</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Classifies a jurisdiction by a controlled level concept such as federal, national, subnational, or supranational.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#withinJurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">within jurisdiction</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
    <skos:definition xml:lang="en">Relates a jurisdiction to a wider jurisdiction whose law applies within it, such as a Member State and the European Union. The relation is transitive.</skos:definition>
    <cdsg:module>jurisdiction</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isOperationalizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is operationalized by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#operationalizesTargetCategory"/>
    <skos:definition xml:lang="en">Inverse of operationalizes target category.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#administeredByInstitutionalActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">administered by institutional actor</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
    <skos:definition xml:lang="en">Identifies the institutional actor that the source names as responsible for administering the document, such as the ministry printed in the header of a Korean statute.</skos:definition>
    <cdsg:module>actor</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#InstitutionalActorRole">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">institutional actor role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <skos:definition xml:lang="en">An anti-rigid relational role borne by an institutional actor because it stands in a context-defining relation to a policy specification or document.</skos:definition>
    <cdsg:designRationale xml:lang="en">An institutional actor instantiates an actor role type because a policy specification or document designates it as implementer, coordinator, consulted actor, issuer or publisher. The role is founded on that designation, stated by the object property in the role's equivalence axiom, and does not change whether the actor is an organization or a government post.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#periodEndedByNormativeDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">period ended by normative document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeEffectivePeriodAssertion"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
    <skos:definition xml:lang="en">Identifies the normative document whose revocation, repeal or replacement ends the effective period recorded by a normative effective-period assertion. The assertion keeps the source of that end point traceable; it does not by itself state that every policy use of the affected category has ceased.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#specifiesTargetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">specifies target category</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement"/>
    <skos:definition xml:lang="en">General relation from a source target-category statement to the single source-specified category whose criteria or membership conditions it establishes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#sourceStatementText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">source statement text</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <skos:definition xml:lang="en">Textual wording preserved from the source for a target-category statement. Its semantic function is given by the statement subclass, not inferred merely from the wording.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isVersionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is version of</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#specializationOf"/>
    <skos:definition xml:lang="en">Links a normative document version to the normative document whose text state it is.</skos:definition>
    <cdsg:module>normative</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#expressesContent"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#NormativeContent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/org#Post">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativelyDefinedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">normatively defined policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b9"/>
    <skos:definition xml:lang="en">A source-defined policy target category whose explicit definition is normative content carrying institutional force in a jurisdiction.</skos:definition>
    <cdsg:designRationale xml:lang="en">Follows from the disjointness of normative and statistical definitions and from the single specifying statement of a source-specified category.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#constitutesTargetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">constitutes target category</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
    <skos:definition xml:lang="en">Links a normative constitution rule to the source-specified category or status whose membership it establishes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">source-specified policy target category</rdfs:label>
    <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    <rdfs:subClassOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b33"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b34"/>
    <skos:definition xml:lang="en">A policy target category whose extension criteria or membership conditions are explicitly specified by a represented source statement. It is distinct from a research-curated comparison category.</skos:definition>
    <cdsg:designRationale xml:lang="en">A source-specified category is a gufo:RoleMixin. It is non-sortal because its members are of different kinds. It is anti-rigid because membership holds only while a source statement specifies it: an individual ceases to fall under the category, without ceasing to exist, when the specifying norm is revoked or amended. Executive Order 13166, revoked by Executive Order 14224, is the case in the evidence set. The existential dependence of the category on a specifying statement is stated by the equivalence axiom of this class.</cdsg:designRationale>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentPlanningPeriodAssertion">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document planning period assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
    <skos:definition xml:lang="en">A temporal qualification stating the planning horizon explicitly associated with a plan, strategy, roadmap, or comparable policy document. It is not the document's physical existence interval and does not automatically establish legal validity.</skos:definition>
    <cdsg:module>temporal</cdsg:module>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b27">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b28"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#publishesPolicyDocument"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/isReplacedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#isDocumentActorFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is document actor for</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
    <skos:definition xml:lang="en">Inverse of has document actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#appliesInJurisdiction"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#NormativeTargetCategoryDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#evidenceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidence document</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <skos:definition xml:lang="en">Identifies the document in which the evidence location occurs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#sourceLocator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">source locator</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A page, section, paragraph, URL fragment, file offset, or comparable source-location locator.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b3">
    <rdf:first rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
    <rdf:rest rdf:nodeID="nb32976c56be042cfa8637a118145dd67b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#expressesContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">expresses content</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isExpressedIn"/>
    <skos:definition xml:lang="en">Links a policy document to abstract policy content expressed by it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentPublisherRole">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">document publisher role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#DocumentActorRole"/>
    <owl:equivalentClass rdf:nodeID="nb32976c56be042cfa8637a118145dd67b5"/>
    <skos:definition xml:lang="en">The anti-rigid role of an institutional actor that publishes a policy document.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb32976c56be042cfa8637a118145dd67b29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nb32976c56be042cfa8637a118145dd67b31"/>
  </rdf:Description>
