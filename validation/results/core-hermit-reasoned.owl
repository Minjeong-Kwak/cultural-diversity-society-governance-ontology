<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/cdsg/core/"
     xml:base="https://w3id.org/cdsg/core/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:cdsg="https://w3id.org/cdsg/core#"
     xmlns:gufo="http://purl.org/nemo/gufo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/cdsg/core/">
        <owl:versionIRI rdf:resource="https://w3id.org/cdsg/core/1.0.0-rc.2"/>
        <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
        <dcterms:conformsTo rdf:resource="http://purl.org/nemo/gufo#/1.0.0"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-12</dcterms:created>
        <dcterms:description xml:lang="en">Release candidate 2 core ontology for the Cultural Diversity Society Governance (CDSG) ontology. It formalizes distinctions among policy content, documentary artifacts, institutional actors and roles, target categories and roles, source-relative assertions, situations, provenance, and qualified temporal and normative context.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:title xml:lang="en">Cultural Diversity Society Governance Core Ontology</dcterms:title>
        <vann:preferredNamespacePrefix>cdsg</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/cdsg/core#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">CDSG Core Ontology</rdfs:label>
        <owl:versionInfo>1.0.0-rc.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/alternative -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/alternative"/>
    


    <!-- http://purl.org/dc/terms/conformsTo -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/conformsTo"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/isReplacedBy -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isReplacedBy"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- https://w3id.org/cdsg/core#designRationale -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/cdsg/core#designRationale">
        <rdfs:label xml:lang="en">design rationale</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/cdsg/core#module -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/cdsg/core#module">
        <rdfs:label xml:lang="en">module</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning"/>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd"/>
    


    <!-- http://www.w3.org/ns/prov#specializationOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#specializationOf"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- https://w3id.org/cdsg/core#administeredByInstitutionalActor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#administeredByInstitutionalActor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:label xml:lang="en">administered by institutional actor</rdfs:label>
        <skos:definition xml:lang="en">Identifies the institutional actor that the source names as responsible for administering the document, such as the ministry printed in the header of a Korean statute.</skos:definition>
        <cdsg:module>actor</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#appliesInJurisdiction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#appliesInJurisdiction">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
        <rdfs:label xml:lang="en">applies in jurisdiction</rdfs:label>
        <skos:definition xml:lang="en">Identifies a jurisdiction in which the policy content is intended to have application or interpretive relevance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#constitutesTargetCategory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#constitutesTargetCategory">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isConstitutedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
        <rdfs:label xml:lang="en">constitutes target category</rdfs:label>
        <skos:definition xml:lang="en">Links a normative constitution rule to the source-specified category or status whose membership it establishes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#definesTargetCategory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#definesTargetCategory">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
        <rdfs:label xml:lang="en">defines target category</rdfs:label>
        <skos:definition xml:lang="en">Links an explicit source definition to the source-defined policy target category whose extension criteria it states.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#evidenceDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#evidenceDocument">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">evidence document</rdfs:label>
        <skos:definition xml:lang="en">Identifies the document in which the evidence location occurs.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#evidenceDocumentVersion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#evidenceDocumentVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:label xml:lang="en">evidence document version</rdfs:label>
        <skos:definition xml:lang="en">Identifies the version of a normative document in which the evidence location occurs.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#expressesContent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#expressesContent">
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isExpressedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
        <rdfs:label xml:lang="en">expresses content</rdfs:label>
        <skos:definition xml:lang="en">Links a policy document to abstract policy content expressed by it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasDocumentActor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasDocumentActor">
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#isDocumentActorFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:label xml:lang="en">has document actor</rdfs:label>
        <skos:definition xml:lang="en">General relation from a policy document to an institutional actor standing in a document-level role.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasGovernmentPost -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasGovernmentPost">
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#postInOrganization"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Organization"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#GovernmentPost"/>
        <rdfs:label xml:lang="en">has government post</rdfs:label>
        <skos:definition xml:lang="en">Inverse of post in organization.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasIdentityEvidence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasIdentityEvidence">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:label xml:lang="en">has identity evidence</rdfs:label>
        <skos:definition xml:lang="en">Links an institutional actor to evidence supporting its identification or institutional classification in the curated corpus.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasInstitutionalActorType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasInstitutionalActorType">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">has institutional actor classification</rdfs:label>
        <skos:definition xml:lang="en">Links an organization to its institutional type in the controlled institutional actor type scheme; the classification is not treated as an ontological identity condition.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasJurisdictionEvidence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasJurisdictionEvidence">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:label xml:lang="en">has jurisdiction evidence</rdfs:label>
        <skos:definition xml:lang="en">Links a jurisdiction individual to evidence supporting its identification or classification in the curated corpus.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasJurisdictionLevel -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasJurisdictionLevel">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">has jurisdiction level</rdfs:label>
        <skos:definition xml:lang="en">Classifies a jurisdiction by a controlled level concept such as federal, national, subnational, or supranational.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasSourceEvidence -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasSourceEvidence">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:label xml:lang="en">has source evidence</rdfs:label>
        <skos:definition xml:lang="en">Links policy content or an assertion to a provenance record that identifies supporting documentary evidence.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#hasTemporalInterval -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#hasTemporalInterval">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:label xml:lang="en">has temporal interval</rdfs:label>
        <skos:definition xml:lang="en">Identifies the interval used by a temporal qualification assertion. The interval itself is represented using OWL-Time.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isConstitutedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isConstitutedBy">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
        <rdfs:label xml:lang="en">is constituted by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of constitutes target category.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isDefinedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isDefinedBy">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
        <rdfs:label xml:lang="en">is defined by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of defines target category.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isDocumentActorFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isDocumentActorFor">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">is document actor for</rdfs:label>
        <skos:definition xml:lang="en">Inverse of has document actor.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isExpressedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isExpressedIn">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">is expressed in</rdfs:label>
        <skos:definition xml:lang="en">Links abstract policy content to a document that expresses it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isOperationalizedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isOperationalizedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#operationalizesTargetCategory"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
        <rdfs:label xml:lang="en">is operationalized by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of operationalizes target category.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement">
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:label xml:lang="en">is specified by target-category statement</rdfs:label>
        <skos:definition xml:lang="en">Inverse of specifies target category.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#isVersionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#isVersionOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#specializationOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
        <rdfs:label xml:lang="en">is version of</rdfs:label>
        <skos:definition xml:lang="en">Links a normative document version to the normative document whose text state it is.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#issuedByInstitutionalActor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#issuedByInstitutionalActor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#issuesPolicyDocument"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:label xml:lang="en">issued by institutional actor</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy document to the institutional actor explicitly identified as issuing it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#issuesPolicyDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#issuesPolicyDocument">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">issues policy document</rdfs:label>
        <skos:definition xml:lang="en">Inverse of issued by institutional actor.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#operationalizesTargetCategory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#operationalizesTargetCategory">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#specifiesTargetCategory"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
        <rdfs:label xml:lang="en">operationalizes target category</rdfs:label>
        <skos:definition xml:lang="en">Links an operationalization statement to the source-specified category whose membership criteria it operationalizes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#periodEndedByNormativeDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#periodEndedByNormativeDocument">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeEffectivePeriodAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
        <rdfs:label xml:lang="en">period ended by normative document</rdfs:label>
        <skos:definition xml:lang="en">Identifies the normative document whose revocation, repeal or replacement ends the effective period recorded by a normative effective-period assertion. The assertion keeps the source of that end point traceable; it does not by itself state that every policy use of the affected category has ceased.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#postInOrganization -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#postInOrganization">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#GovernmentPost"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Organization"/>
        <rdfs:label xml:lang="en">post in organization</rdfs:label>
        <skos:definition xml:lang="en">Relates a government post to the organization in which the source models that post as institutionally located.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#preparedByInstitutionalActor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#preparedByInstitutionalActor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:label xml:lang="en">prepared by institutional actor</rdfs:label>
        <skos:definition xml:lang="en">Identifies the institutional actor that the source names as having prepared the document for its issuer.</skos:definition>
        <cdsg:module>actor</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#publishedByInstitutionalActor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#publishedByInstitutionalActor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#hasDocumentActor"/>
        <owl:inverseOf rdf:resource="https://w3id.org/cdsg/core#publishesPolicyDocument"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:label xml:lang="en">published by institutional actor</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy document to the institutional actor explicitly identified as publishing it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#publishesPolicyDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#publishesPolicyDocument">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#InstitutionalActor"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">publishes policy document</rdfs:label>
        <skos:definition xml:lang="en">Inverse of published by institutional actor.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#qualifiesPolicyDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#qualifiesPolicyDocument">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cdsg/core#temporallyQualifies"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">qualifies policy document</rdfs:label>
        <skos:definition xml:lang="en">Temporal qualification of a policy document.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#specifiesTargetCategory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#specifiesTargetCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
        <rdfs:label xml:lang="en">specifies target category</rdfs:label>
        <skos:definition xml:lang="en">General relation from a source target-category statement to the single source-specified category whose criteria or membership conditions it establishes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#supersededDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#supersededDocument">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#DocumentSupersessionAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">superseded document</rdfs:label>
        <skos:definition xml:lang="en">Identifies the earlier document that, according to the source, is replaced.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#supersedingDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#supersedingDocument">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#DocumentSupersessionAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:label xml:lang="en">superseding document</rdfs:label>
        <skos:definition xml:lang="en">Identifies the later document that, according to the source, replaces the earlier one.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#temporallyQualifies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#temporallyQualifies">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#TemporalQualificationAssertion"/>
        <rdfs:label xml:lang="en">temporally qualifies</rdfs:label>
        <skos:definition xml:lang="en">Identifies the single resource whose temporal qualification is asserted.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#versionKind -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#versionKind">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="en">version kind</rdfs:label>
        <skos:definition xml:lang="en">Classifies a normative document version as an original text or an official consolidation, using the document version kind scheme.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cdsg/core#withinJurisdiction -->

    <owl:ObjectProperty rdf:about="https://w3id.org/cdsg/core#withinJurisdiction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
        <rdfs:range rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
        <rdfs:label xml:lang="en">within jurisdiction</rdfs:label>
        <skos:definition xml:lang="en">Relates a jurisdiction to a wider jurisdiction whose law applies within it, such as a Member State and the European Union. The relation is transitive.</skos:definition>
        <cdsg:module>jurisdiction</cdsg:module>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/identifier -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/language -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/language"/>
    


    <!-- http://www.w3.org/2006/time#inXSDDateTime -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#inXSDDateTime"/>
    


    <!-- https://w3id.org/cdsg/core#documentReferenceYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#documentReferenceYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">document reference year</rdfs:label>
        <skos:definition xml:lang="en">A reference, edition, or reporting year attached to a policy document. It is distinct from issue date, effective date, and explicit multi-year coverage or planning intervals.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#evidencePage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#evidencePage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">evidence page</rdfs:label>
        <skos:definition xml:lang="en">Records a page or page-range locator supplied for a source-evidence record.</skos:definition>
        <cdsg:designRationale xml:lang="en">Functional from rc.2: each evidence record supports one claim and cites one page or page range of one file. Evidence taken from a web page has no page and is located by its address instead.</cdsg:designRationale>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#evidenceSourceFileName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#evidenceSourceFileName">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">evidence source file name</rdfs:label>
        <skos:definition xml:lang="en">The file name recorded by the curated dataset for the source document used by an evidence record.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#evidenceSourceURI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#evidenceSourceURI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">evidence source URI</rdfs:label>
        <skos:definition xml:lang="en">The web address of the page on which the evidence location occurs, for evidence taken from a web source rather than a file in the corpus. Such a record carries the retrieval time.</skos:definition>
        <cdsg:module>provenance</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#evidenceText -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#evidenceText">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">evidence text</rdfs:label>
        <skos:definition xml:lang="en">Records source text or an evidential excerpt supporting the assertion represented by an evidence record.</skos:definition>
        <cdsg:designRationale xml:lang="en">Each evidence record supports one claim and carries one verbatim excerpt; fragments from the same page are joined with &apos; … &apos;.</cdsg:designRationale>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#publisherIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#publisherIdentifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">publisher identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier the publisher assigns to the document or version and prints in it or in its official citation, such as an official citation, a law number, a Federal Register document number, an ISBN or a catalogue number. Recorded as it appears in the source.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#publisherURI -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#publisherURI">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyDocument"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">publisher URI</rdfs:label>
        <skos:definition xml:lang="en">The persistent web address under which the publisher makes the document or version available, such as a European Legislation Identifier (ELI) or a law database address. Recorded only where the source prints it or the address was confirmed at the publisher.</skos:definition>
        <cdsg:designRationale xml:lang="en">Publisher addresses are kept as xsd:anyURI literals rather than as individuals linked by owl:sameAs: an ELI or law-database address names the publisher&apos;s resource, whose identity criteria are the publisher&apos;s, and asserting identity would import them. ELI distinguishes the legal resource from its expressions; CDSG records the address at the matching level, on the normative document or on the cited version.</cdsg:designRationale>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#retrievedOn -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#retrievedOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">retrieved on</rdfs:label>
        <skos:definition xml:lang="en">The time at which the cited file was retrieved, recorded only where the file itself states it, such as a browser print header or a generation stamp.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#sourceLocator -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#sourceLocator">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">source locator</rdfs:label>
        <skos:definition xml:lang="en">A page, section, paragraph, URL fragment, file offset, or comparable source-location locator.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#sourceStatementText -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#sourceStatementText">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">source statement text</rdfs:label>
        <skos:definition xml:lang="en">Textual wording preserved from the source for a target-category statement. Its semantic function is given by the statement subclass, not inferred merely from the wording.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#supersessionEffectiveFrom -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#supersessionEffectiveFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#DocumentSupersessionAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">supersession effective from</rdfs:label>
        <skos:definition xml:lang="en">The date from which the source states that the replacement takes effect.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#versionCurrentTo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#versionCurrentTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">version current to</rdfs:label>
        <skos:definition xml:lang="en">The date up to which the publisher states that a consolidation is current.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#versionIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#versionIdentifier">
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">version identifier</rdfs:label>
        <skos:definition xml:lang="en">The citation, revision identifier or consolidation statement by which the publisher identifies the version, recorded as it appears in the source.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cdsg/core#versionInForceFrom -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/cdsg/core#versionInForceFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cdsg/core#NormativeDocumentVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">version in force from</rdfs:label>
        <skos:definition xml:lang="en">The date from which the publisher states that the text of this version applies. For an original text it is the date of entry into force or signature the source states; for a consolidation it is the in-force date of the latest incorporated amendment.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </owl:DatatypeProperty>
    


    <!-- 
