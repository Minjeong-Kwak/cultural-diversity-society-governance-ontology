    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#DocumentSupersessionAssertion -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#DocumentSupersessionAssertion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyAssertion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#supersededDocument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#supersedingDocument"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


