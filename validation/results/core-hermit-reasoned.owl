    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#PolicyContent -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#PolicyContent">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#AbstractIndividual"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#PolicyDocument -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#PolicyDocument">
