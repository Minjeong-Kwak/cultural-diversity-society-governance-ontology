    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#Type"/>
        <gufo:categorizes rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/core#TemporalQualificationAssertion -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/core#TemporalQualificationAssertion">
        <rdf:type rdf:resource="http://purl.org/nemo/gufo#AbstractIndividualType"/>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentActorRole">
        <rdfs:label xml:lang="en">document actor role</rdfs:label>
        <skos:definition xml:lang="en">A relational role borne by an institutional actor because it stands in an issuance or publication relation to a policy document.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentCoveragePeriodAssertion">
        <rdfs:label xml:lang="en">document coverage period assertion</rdfs:label>
        <skos:definition xml:lang="en">A temporal qualification stating the period covered by a reporting document when the source explicitly presents the interval as a reporting or coverage period.</skos:definition>
        <cdsg:module>temporal</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentIssuerRole">
        <rdfs:label xml:lang="en">document issuer role</rdfs:label>
        <skos:definition xml:lang="en">The anti-rigid role of an institutional actor that issues a policy document.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentPlanningPeriodAssertion">
        <rdfs:label xml:lang="en">document planning period assertion</rdfs:label>
        <skos:definition xml:lang="en">A temporal qualification stating the planning horizon explicitly associated with a plan, strategy, roadmap, or comparable policy document. It is not the document&apos;s physical existence interval and does not automatically establish legal validity.</skos:definition>
        <cdsg:module>temporal</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentPublisherRole">
        <rdfs:label xml:lang="en">document publisher role</rdfs:label>
        <skos:definition xml:lang="en">The anti-rigid role of an institutional actor that publishes a policy document.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentReferencePeriodAssertion">
        <rdfs:label xml:lang="en">document reference period assertion</rdfs:label>
        <skos:definition xml:lang="en">A conservative temporal qualification associating a policy document with a reference or edition period when the evidence does not warrant interpreting that period as validity, planning horizon, or reporting coverage.</skos:definition>
        <cdsg:module>temporal</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#DocumentSupersessionAssertion">
        <rdfs:label xml:lang="en">document supersession assertion</rdfs:label>
        <skos:definition xml:lang="en">A source-relative assertion that a later document replaces an earlier one, so that the definitions or classifications the later document expresses take the place of those in the earlier document. It is recorded only where a source states the replacement.</skos:definition>
        <cdsg:designRationale xml:lang="en">Three changes to a source statement are kept apart. Replacement: a later source states that it replaces or supersedes an earlier document (the 2024 revision of OMB SPD 15 replacing the 1997 standards). Revocation without replacement: a document&apos;s effective period ends and the ending document is recorded with periodEndedByNormativeDocument (Executive Order 13166, revoked by Executive Order 14224). Introduction of a parallel definition: a new concept is added while the old one stays in use (the Federal Statistical Office&apos;s immigration history, introduced as an additional data offer while migration-background results continue to be published); no relation is asserted. Replacement is reified because the source that states it, the evidence and the date from which it takes effect belong to the claim, not to either document.</cdsg:designRationale>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#EvidenceRecord">
        <rdfs:label xml:lang="en">evidence record</rdfs:label>
        <skos:definition xml:lang="en">An abstract provenance record identifying the documentary source and location used to support a policy-content assertion in the knowledge graph. The evidence record is not the source document itself.</skos:definition>
        <cdsg:designRationale xml:lang="en">An evidence record is aligned to gufo:AbstractIndividual because it is an information entity of the knowledge graph that identifies a document, locator and excerpt; it is not the document and has no location or physical identity of its own.</cdsg:designRationale>
        <cdsg:module>provenance</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#GovernmentOrganization">
        <rdfs:label xml:lang="en">government organization</rdfs:label>
        <skos:definition xml:lang="en">An organization belonging to a governmental or public-administration structure. This is a rigid organizational subkind, not a temporary policy role.</skos:definition>
        <cdsg:module>actor</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#GovernmentPost">
        <rdfs:label xml:lang="en">government post</rdfs:label>
        <skos:definition xml:lang="en">A socially instituted government office or position that persists independently of the particular office holder, such as a ministerial or commissioner post.</skos:definition>
        <cdsg:designRationale xml:lang="en">A government post is a position within an organization that persists through changes of its holder; an organization is a functional complex. They are different kinds; see Organization.</cdsg:designRationale>
        <cdsg:module>actor</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#InstitutionalActor">
        <rdfs:label xml:lang="en">institutional actor</rdfs:label>
        <skos:definition xml:lang="en">An identity-bearing institutional entity that can be referred to in policy or document relations. In CDSG this category presently covers organizations and institutionally constituted government posts; it is not itself a policy role.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#InstitutionalActorRole">
        <rdfs:label xml:lang="en">institutional actor role</rdfs:label>
        <skos:definition xml:lang="en">An anti-rigid relational role borne by an institutional actor because it stands in a context-defining relation to a policy specification or document.</skos:definition>
        <cdsg:designRationale xml:lang="en">An institutional actor instantiates an actor role type because a policy specification or document designates it as implementer, coordinator, consulted actor, issuer or publisher. The role is founded on that designation, stated by the object property in the role&apos;s equivalence axiom, and does not change whether the actor is an organization or a government post.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#Jurisdiction">
        <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
        <skos:definition xml:lang="en">An identity-bearing legally or institutionally constituted domain of authority used to qualify the applicability, observation, or target context of policy information. Federal, national, subnational, and supranational levels are treated as controlled classifications rather than distinct ontological kinds.</skos:definition>
        <cdsg:module>context</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeContent">
        <rdfs:label xml:lang="en">normative content</rdfs:label>
        <skos:definition xml:lang="en">Policy content that has normative force in virtue of an institutional source and context.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocument">
        <rdfs:label xml:lang="en">normative document</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <skos:definition xml:lang="en">A policy document whose institutional status gives normative force to at least some content it expresses, such as a statute, regulation, executive order, or formal administrative decision.</skos:definition>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeDocumentVersion">
        <rdfs:label xml:lang="en">normative document version</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalExpression"/>
        <skos:definition xml:lang="en">A published text state of a normative document: the original text as made or published, or an official consolidation that incorporates amendments up to a stated point. Each version is a version of exactly one normative document, and a source statement is cited from a version.</skos:definition>
        <cdsg:designRationale xml:lang="en">A normative document keeps its identity while it is amended, so it is modelled as a gufo:Object whose text changes over time. The definition a source statement cites belongs to one fixed text state. The version is a separate gufo:Kind, disjoint with PolicyDocument, so that document identity, text state and propositional content are not conflated. isVersionOf specializes prov:specializationOf, the PROV relation for a more specific state of an entity. Dates are recorded only as the publisher states them; no in-force date is inferred.</cdsg:designRationale>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativeEffectivePeriodAssertion">
        <rdfs:label xml:lang="en">normative effective period assertion</rdfs:label>
        <skos:definition xml:lang="en">A source-relative temporal qualification stating an effective or applicability interval for a normative document. It is distinct from the document&apos;s issue date and should be used only when the source warrants an effectiveness interpretation.</skos:definition>
        <cdsg:module>temporal</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory">
        <rdfs:label xml:lang="en">normatively constituted policy target category</rdfs:label>
        <skos:definition xml:lang="en">A source-specified policy target category whose membership or status is constituted by a normative rule rather than merely described by a lexical definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Follows from the disjointness of constitution rules from definitions and operationalizations and from the single specifying statement of a source-specified category.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#NormativelyDefinedPolicyTargetCategory">
        <rdfs:label xml:lang="en">normatively defined policy target category</rdfs:label>
        <skos:definition xml:lang="en">A source-defined policy target category whose explicit definition is normative content carrying institutional force in a jurisdiction.</skos:definition>
        <cdsg:designRationale xml:lang="en">Follows from the disjointness of normative and statistical definitions and from the single specifying statement of a source-specified category.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory">
        <rdfs:label xml:lang="en">operationalized policy target category</rdfs:label>
        <skos:definition xml:lang="en">A source-specified policy target category whose membership criteria are operationalized for statistical or administrative use rather than presented as a legal definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Follows from the disjointness of operationalizations and constitution rules and from the single specifying statement of a source-specified category.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#Organization">
        <rdfs:label xml:lang="en">organization</rdfs:label>
        <skos:definition xml:lang="en">A socially constituted functional complex with an organizational identity that persists through changes in members, office holders, and many internal arrangements.</skos:definition>
        <cdsg:designRationale xml:lang="en">An organization is a functional complex whose identity persists through changes of members and office holders; a government post is a position within an organization that persists through changes of its holder. They are different kinds, so neither can be the other, and reasoning from a post&apos;s document roles must not reclassify it as an organization; an inconsistency fixture tests this.</cdsg:designRationale>
        <cdsg:module>actor</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyAssertion">
        <rdfs:label xml:lang="en">policy assertion</rdfs:label>
        <skos:definition xml:lang="en">Policy content that asserts or reports that some policy-relevant state of affairs, event, status, or outcome obtains or obtained. An assertion is distinct from the situation or event it describes.</skos:definition>
        <cdsg:module>provenance</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyContent">
        <rdfs:label xml:lang="en">policy content</rdfs:label>
        <skos:definition xml:lang="en">An abstract information content item expressed in one or more policy documents. It can be a prescription, goal, definition, recommendation, or descriptive assertion, but is not itself the document that bears it.</skos:definition>
        <cdsg:designRationale xml:lang="en">Policy content is aligned to gufo:AbstractIndividual because it is propositional content: the same specification, definition or assertion can be expressed in several documents and versions, and its identity does not depend on any physical inscription. The document that expresses it is a separate gufo:Object linked by isExpressedIn.</cdsg:designRationale>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyDocument">
        <rdfs:label xml:lang="en">policy document</rdfs:label>
        <skos:definition xml:lang="en">A socially recognized information-bearing document used to formulate, mandate, explain, evaluate, or report public policy. The document is distinct from the abstract policy content that it expresses.</skos:definition>
        <cdsg:designRationale xml:lang="en">A policy document keeps its identity while its text is amended, republished or consolidated, so it is a gufo:Object of its own kind. The definitions, rules and measures it contains are policy content, modelled separately as abstract individuals and linked to the document by isExpressedIn.</cdsg:designRationale>
        <cdsg:module>normative</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategory">
        <rdfs:label xml:lang="en">policy target category</rdfs:label>
        <skos:definition xml:lang="en">A higher-order type used to classify endurants as belonging to a policy-relevant category. A policy target category is distinct from a definition or rule that specifies its criteria, from any concrete bearer falling under it, and from the anti-rigid policy-target role a bearer may acquire in a policy context.</skos:definition>
        <cdsg:designRationale xml:lang="en">Source-specified target categories and research-curated comparison categories are distinct resources. Category-level targeting does not entail that any concrete bearer has actually received a policy intervention. The instances of PolicyTargetCategory are categories, which classify endurants; the instances of PolicyTargetRole are endurants in a target role. A category is not an endurant in a role, so the two are disjoint.</cdsg:designRationale>
        <cdsg:module>target</cdsg:module>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetRole">
        <rdfs:label xml:lang="en">policy target role</rdfs:label>
        <skos:definition xml:lang="en">An anti-rigid relational role borne by a concrete endurant because policy content places it among the targets of a policy, directly or through a target category it falls under. It is distinct from the target category itself, and membership in a category does not by itself entail the role.</skos:definition>
        <cdsg:designRationale xml:lang="en">Policy target roles and institutional actor roles are relational types founded on the designation expressed in policy content: a bearer instantiates the role type because policy content names it, or a category it falls under, in that capacity. CDSG does not introduce gUFO relators for these designations; where the founding relation is stated, it is the object property in the role&apos;s equivalence axiom. The core declares the policy target role without such an axiom because this release records target categories, not individual bearers. The policy-process extension defines the direct target role by isDirectTargetOf and leaves the category-mediated target role to an explicit membership assertion. An actor that instantiates a role type is not thereby reclassified in its kind.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory">
        <rdfs:label xml:lang="en">source-defined policy target category</rdfs:label>
        <skos:definition xml:lang="en">A source-specified policy target category whose extension is stated through an explicit category definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Source-specified categories are individuated by the statement that specifies them: the migration-background category of MighEV section 6 and that of the Federal Statistical Office variant 1.1 are two categories. A source-specified category has at most one specifying statement, so the disjointness of the statement types carries over to the category types. A category that a source defines is therefore not one that a source constitutes or operationalizes; a fixture tests that a category given two specifying statements of different types is inconsistent.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory">
        <rdfs:label xml:lang="en">source-specified policy target category</rdfs:label>
        <skos:definition xml:lang="en">A policy target category whose extension criteria or membership conditions are explicitly specified by a represented source statement. It is distinct from a research-curated comparison category.</skos:definition>
        <cdsg:designRationale xml:lang="en">A source-specified category is a gufo:RoleMixin. It is non-sortal because its members are of different kinds. It is anti-rigid because membership holds only while a source statement specifies it: an individual ceases to fall under the category, without ceasing to exist, when the specifying norm is revoked or amended. Executive Order 13166, revoked by Executive Order 14224, is the case in the evidence set. The existential dependence of the category on a specifying statement is stated by the equivalence axiom of this class.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory">
        <rdfs:label xml:lang="en">statistically defined policy target category</rdfs:label>
        <skos:definition xml:lang="en">A source-defined policy target category whose extension criteria are stated in a statistical standard or statistical definition rather than constituted by a normative rule.</skos:definition>
        <cdsg:designRationale xml:lang="en">Follows from the disjointness of normative and statistical definitions and from the single specifying statement of a source-specified category.</cdsg:designRationale>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cdsg/core#TemporalQualificationAssertion">
        <rdfs:label xml:lang="en">temporal qualification assertion</rdfs:label>
        <skos:definition xml:lang="en">A source-relative assertion that qualifies a policy-relevant item with a temporal interval. It reifies the qualification so that the semantic kind of time relation, the interval, the qualified item, and provenance can be represented separately.</skos:definition>
        <cdsg:module>temporal</cdsg:module>
    </rdf:Description>
</rdf:RDF>



