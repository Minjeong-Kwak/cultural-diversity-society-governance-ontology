        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#RigidType"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#Collection -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#Collection">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#ComparativeRelationshipType -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#ComparativeRelationshipType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#RelationshipType"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#ConcreteIndividual -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#ConcreteIndividual">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Individual"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#ConcreteIndividualType -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#ConcreteIndividualType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Type"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#Endurant -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#Endurant">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividual"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#EndurantType -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#EndurantType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividualType"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#Event -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#Event">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividual"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#EventType -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#EventType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ConcreteIndividualType"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#ExtrinsicAspect -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#ExtrinsicAspect">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Aspect"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#ExtrinsicMode -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#ExtrinsicMode">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#ExtrinsicAspect"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#FixedCollection -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#FixedCollection">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Collection"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#FunctionalComplex -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#FunctionalComplex">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Object"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#Individual -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#Individual">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#IntrinsicAspect -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#IntrinsicAspect">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Aspect"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#IntrinsicMode -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#IntrinsicMode">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#IntrinsicAspect"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#Kind -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#Kind">
