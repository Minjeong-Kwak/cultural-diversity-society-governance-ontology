        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#PolicyTargetCategory -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategory">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#NonSortal"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#PolicyTargetRole"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#PolicyTargetCategoryStatement -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyContent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#appliesInJurisdiction"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#Jurisdiction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#hasSourceEvidence"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isExpressedIn"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyDocument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">policy target category statement</rdfs:label>
        <skos:definition xml:lang="en">Source-expressed policy content concerning the criteria, constitution, operationalization, classification, or terminology of policy target categories. Subclasses distinguish these different semantic functions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#PolicyTargetRole -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#PolicyTargetRole">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Endurant"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#SourceSpecifiedPolicyTargetCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#RoleMixin"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isSpecifiedByTargetCategoryStatement"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition"/>
        <rdfs:label xml:lang="en">statistical target category definition</rdfs:label>
        <skos:definition xml:lang="en">An explicit target-category definition used by a statistical authority or standard and not represented as a normatively constitutive legal definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Normative and statistical definitions are told apart by the institutional status of the source: a definition carries institutional force in a jurisdiction or it does not. See NormativeTargetCategoryDefinition.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#StatisticallyDefinedPolicyTargetCategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#isDefinedBy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/cdsg/core#StatisticalTargetCategoryDefinition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement"/>
        <rdfs:label xml:lang="en">target category classification-scheme statement</rdfs:label>
        <skos:definition xml:lang="en">A source statement specifying a classification scheme, classification dimensions, or a set of categories without defining a single policy target category represented as one OWL class.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. A classification scheme statement lays out a set of categories or dimensions without fixing one category, which separates it from a definition and from a statement that only fixes or reports a term.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TargetCategoryConstitutionRule -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#NormativeContent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#constitutesTargetCategory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#NormativelyConstitutedPolicyTargetCategory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
        <rdfs:label xml:lang="en">target category constitution rule</rdfs:label>
        <skos:definition xml:lang="en">Normative content that establishes how membership in or acquisition of a policy-relevant legal status or category comes about. It is not conflated with a lexical category definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage, and a passage that performs two functions is recorded as two statements. A constitution rule creates a category&apos;s status by legal force; a definition states criteria for a term and an operationalization gives criteria without legal force, so the three are kept apart.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TargetCategoryOperationalization -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TargetCategoryOperationalization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#operationalizesTargetCategory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#OperationalizedPolicyTargetCategory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetPopulationOperationalizationStatement"/>
        <rdfs:label xml:lang="en">target category operationalization</rdfs:label>
        <skos:definition xml:lang="en">A source statement giving operational criteria used to delimit membership in a single policy-relevant target category without treating those criteria as a legal definition.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. An operationalization gives measurement or administrative criteria for one category without legal force; a constitution rule creates the category&apos;s status by legal force, so the two are kept apart.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:label xml:lang="en">target category terminology statement</rdfs:label>
        <skos:definition xml:lang="en">A source statement about the terminology used for one or more population or target categories, without itself fixing the extension of a single target category.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage, and a passage that performs two functions is recorded as two statements. A terminology statement fixes or reports the term used for a category without stating its extension, which separates it from a definition and from a classification scheme.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TargetPopulationOperationalizationStatement -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TargetPopulationOperationalizationStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:label xml:lang="en">target population operationalization statement</rdfs:label>
        <skos:definition xml:lang="en">A source statement identifying indicators, dimensions, or measurement variables for operationalizing a target-population construct without fixing the extension of one single policy target category.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. A population operationalization names indicators or variables for a construct without fixing the extension of one category, which separates it from an explicit definition and from the operationalization of one category.</cdsg:designRationale>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#TemporalQualificationAssertion -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#TemporalQualificationAssertion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyAssertion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#hasTemporalInterval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#Interval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#temporallyQualifies"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


