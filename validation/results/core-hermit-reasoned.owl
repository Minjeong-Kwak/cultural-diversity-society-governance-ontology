        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Type"/>
    </rdf:Description>
    


    <!-- http://purl.org/nemo/gufo#AntiRigidType -->

    <rdf:Description rdf:about="http://purl.org/nemo/gufo#AntiRigidType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#NonRigidType"/>
    </rdf:Description>
    


