            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition -->

    <owl:Class rdf:about="https://w3id.org/cdsg/core#ExplicitTargetCategoryDefinition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cdsg/core#definesTargetCategory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cdsg/core#SourceDefinedPolicyTargetCategory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryConstitutionRule"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryOperationalization"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cdsg/core#TargetPopulationOperationalizationStatement"/>
        <rdfs:label xml:lang="en">explicit target category definition</rdfs:label>
        <skos:definition xml:lang="en">A source statement that explicitly states extension criteria for a single target category using definitional content such as “means”, “is”, or an equivalent criterion.</skos:definition>
        <cdsg:designRationale xml:lang="en">Statement types are disjoint by a recording rule: each statement record captures one semantic function of one source passage. A passage that both defines a category and operationalizes it is recorded as two statements, so a statement is never typed by two functions. An explicit definition states the extension criteria of one category; a classification scheme, a constitution rule, an operationalization and a terminology statement do not, so they are kept apart from it.</cdsg:designRationale>
    </owl:Class>
    


