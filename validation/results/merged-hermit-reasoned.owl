        <rdf:type rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#TargetCategoryTerminologyStatement"/>
        <cdsg:appliesInJurisdiction rdf:resource="https://w3id.org/cdsg/resource/ca/FederalJurisdiction_1c75a772"/>
        <cdsg:hasSourceEvidence rdf:resource="https://w3id.org/cdsg/resource/evidence/SourceEvidence_402fb31b"/>
        <cdsg:isExpressedIn rdf:resource="https://w3id.org/cdsg/resource/ca/StatisticalStandardDocument_c2aaf2bf"/>
        <cdsg:sourceStatementText xml:lang="en">1. Increasingly, the “visible minority population” is being referred to as the “racialized population” by media, academia and other groups. For 2021, Statistics Canada has chosen to continue to use the term “visible minority” in published data tables and reference materials because this is the term currently used by the federal Employment Equity Act. 4</cdsg:sourceStatementText>
        <rdfs:label xml:lang="en">Statistics Canada deference to the Employment Equity Act term</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/resource/ca/CategoryDefinition_c224e635 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/ca/CategoryDefinition_c224e635">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#NormativeTargetCategoryDefinition"/>
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <cdsg:appliesInJurisdiction rdf:resource="https://w3id.org/cdsg/resource/ca/FederalJurisdiction_1c75a772"/>
        <cdsg:definesTargetCategory rdf:resource="https://w3id.org/cdsg/resource/target/source/category-c224e635"/>
        <cdsg:hasSourceEvidence rdf:resource="https://w3id.org/cdsg/resource/evidence/SourceEvidence_f2fced91"/>
        <cdsg:isExpressedIn rdf:resource="https://w3id.org/cdsg/resource/ca/Statute_c0d7710a"/>
        <cdsg:sourceStatementText xml:lang="en">members of visible minorities means persons, other than Aboriginal peoples, who are non-Caucasian in race or non-white in colour; (minorités visibles)</cdsg:sourceStatementText>
        <rdfs:label xml:lang="en">Definition of members of visible minorities, Employment Equity Act s. 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/resource/ca/CategoryDefinition_dd6fa091 -->

