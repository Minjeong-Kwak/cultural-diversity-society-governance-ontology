    <!-- https://w3id.org/cdsg/resource/jp/AdministrativeDecision_7d434ad0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/jp/AdministrativeDecision_7d434ad0">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#NormativeDocument"/>
