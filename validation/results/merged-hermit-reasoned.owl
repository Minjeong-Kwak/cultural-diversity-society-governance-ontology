    <!-- https://w3id.org/cdsg/resource/evidence/SourceEvidence_8557e9f0 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/evidence/SourceEvidence_8557e9f0">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <cdsg:evidenceDocument rdf:resource="https://w3id.org/cdsg/resource/kr/Statute_9feedf13"/>
        <cdsg:evidenceDocumentVersion rdf:resource="https://w3id.org/cdsg/resource/kr/NormativeDocumentVersion_9feedf13_20221001"/>
        <cdsg:evidencePage>1</cdsg:evidencePage>
        <cdsg:evidenceSourceFileName>국적법(법률)(제18978호)(20221001).pdf</cdsg:evidenceSourceFileName>
        <cdsg:evidenceText xml:lang="ko">제2조(출생에 의한 국적 취득) ① 다음 각 호의 어느 하나에 해당하는 자는 출생과 동시에 대한민국 국적(國籍)을 취득 한다. 1. 출생 당시에 부(父)또는 모(母)가 대한민국의 국민인 자 2. 출생하기 전에 부가 사망한 경우에는 그 사망 당시에 부가 대한민국의 국민이었던 자 3. 부모가 모두 분명하지 아니한 경우나 국적이 없는 경우에는 대한민국에서 출생한 자</cdsg:evidenceText>
        <cdsg:sourceLocator>제2조</cdsg:sourceLocator>
        <rdfs:label xml:lang="en">Acquisition of nationality by birth, Nationality Act art. 2 - source evidence</rdfs:label>
