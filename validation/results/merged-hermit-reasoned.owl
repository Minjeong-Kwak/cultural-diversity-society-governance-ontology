    <!-- https://w3id.org/cdsg/resource/evidence/SourceEvidence_402fb31b -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/evidence/SourceEvidence_402fb31b">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
        <cdsg:evidenceDocument rdf:resource="https://w3id.org/cdsg/resource/ca/StatisticalStandardDocument_c2aaf2bf"/>
        <cdsg:evidencePage>4</cdsg:evidencePage>
        <cdsg:evidenceSourceFileName>98-500-x2021006-eng.pdf</cdsg:evidenceSourceFileName>
        <cdsg:evidenceText xml:lang="en">1. Increasingly, the “visible minority population” is being referred to as the “racialized population” by media, academia and other groups. For 2021, Statistics Canada has chosen to continue to use the term “visible minority” in published data tables and reference materials because this is the term currently used by the federal Employment Equity Act. 4</cdsg:evidenceText>
        <cdsg:sourceLocator>Note 1</cdsg:sourceLocator>
        <rdfs:label xml:lang="en">Statistics Canada deference to the Employment Equity Act term - source evidence</rdfs:label>
    </owl:NamedIndividual>
    


