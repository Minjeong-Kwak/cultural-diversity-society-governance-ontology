        <skos:inScheme rdf:resource="https://w3id.org/cdsg/vocab#TargetCategorySourcingOutcomeScheme"/>
        <skos:definition xml:lang="en">A source statement in the corpus defines, constitutes or operationalizes a category closely aligned with the curated category.</skos:definition>
        <skos:prefLabel xml:lang="en">membership specified by a source</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/vocab#sourcing-outcome/no-source-statement-identified -->

