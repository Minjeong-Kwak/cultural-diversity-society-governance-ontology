    <!-- https://w3id.org/cdsg/vocab#source-validity/in-force -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/vocab#source-validity/in-force">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://w3id.org/cdsg/vocab#SourceValidityStatusScheme"/>
        <skos:definition xml:lang="en">The specifying source was in force at the reference date. For a statistical definition, which carries no legal force, the issuing office still applied it at that date.</skos:definition>
        <skos:prefLabel xml:lang="en">in force</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/vocab#source-validity/no-longer-in-force -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/vocab#source-validity/no-longer-in-force">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://w3id.org/cdsg/vocab#SourceValidityStatusScheme"/>
        <skos:definition xml:lang="en">The specifying source had been revoked, repealed or replaced before the reference date.</skos:definition>
        <skos:prefLabel xml:lang="en">no longer in force</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/vocab#source-validity/not-assessed -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/vocab#source-validity/not-assessed">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://w3id.org/cdsg/vocab#SourceValidityStatusScheme"/>
        <skos:definition xml:lang="en">The force of the specifying source at the reference date was not assessed.</skos:definition>
        <skos:prefLabel xml:lang="en">not assessed</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/vocab#sourcing-outcome/context-statement-only -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/vocab#sourcing-outcome/context-statement-only">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://w3id.org/cdsg/vocab#TargetCategorySourcingOutcomeScheme"/>
        <skos:definition xml:lang="en">The corpus contains source statements about the category&apos;s classification, terminology or population operationalization, but none that specifies membership.</skos:definition>
        <skos:prefLabel xml:lang="en">context statement only</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/vocab#sourcing-outcome/membership-specified -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/vocab#sourcing-outcome/membership-specified">
