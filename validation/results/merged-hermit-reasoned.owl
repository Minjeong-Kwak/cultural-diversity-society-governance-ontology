    <!-- https://w3id.org/cdsg/resource/evidence/SourceEvidence_277b4f39 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/evidence/SourceEvidence_277b4f39">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#EvidenceRecord"/>
