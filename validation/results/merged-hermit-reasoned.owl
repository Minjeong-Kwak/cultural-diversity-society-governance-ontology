        <cdsg:sourceStatementText xml:lang="en">The Minimum Core Set of Cultural and Language Indicators consists of four concepts: Country of Birth of Person – see Country of Birth Standard (/statistics/standards/country -birth-standard/latest-release) Main Language Other Than English Spoken at Home – see Language Standards (/statistic s/standards/language-standards/latest-release)</cdsg:sourceStatementText>
        <rdfs:label xml:lang="en">Minimum Core Set of Cultural and Language Indicators</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/resource/au/CategoryDefinition_5899548e -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/au/CategoryDefinition_5899548e">
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#TargetCategoryClassificationSchemeStatement"/>
        <cdsg:appliesInJurisdiction rdf:resource="https://w3id.org/cdsg/resource/au/FederalJurisdiction_23487cb5"/>
        <cdsg:hasSourceEvidence rdf:resource="https://w3id.org/cdsg/resource/evidence/SourceEvidence_101bb5ea"/>
        <cdsg:isExpressedIn rdf:resource="https://w3id.org/cdsg/resource/au/StatisticalStandardDocument_fb67a523"/>
        <cdsg:sourceStatementText xml:lang="en">Australian Census of Population and Housing) (the Borrie Report). The key factor for the inclusion of an ethnic group is the group regarding itself and being regarded by others, as a distinct community by virtue of certain characteristics, not all of which have to be present in the case of each ethnic group. Self-perceived group identification has influenced the content of the ASCCEG more so than</cdsg:sourceStatementText>
        <rdfs:label xml:lang="en">Conceptual basis of ethnic group inclusion, ASCCEG 2025</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cdsg/resource/au/ChildOrYouthWithMigrationBackgroundPopulation_7d705d97 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/cdsg/resource/au/ChildOrYouthWithMigrationBackgroundPopulation_7d705d97">
        <rdf:type rdf:resource="https://w3id.org/cdsg/analytics#CuratedPolicyTargetCategory"/>
