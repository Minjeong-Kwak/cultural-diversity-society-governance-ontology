        <rdf:type rdf:resource="https://w3id.org/cdsg/core#NormativeTargetCategoryDefinition"/>
        <rdf:type rdf:resource="https://w3id.org/cdsg/core#PolicyTargetCategoryStatement"/>
        <cdsg:appliesInJurisdiction rdf:resource="https://w3id.org/cdsg/resource/ca/FederalJurisdiction_1c75a772"/>
        <cdsg:definesTargetCategory rdf:resource="https://w3id.org/cdsg/resource/target/source/category-dd6fa091"/>
        <cdsg:hasSourceEvidence rdf:resource="https://w3id.org/cdsg/resource/evidence/SourceEvidence_2719e747"/>
        <cdsg:isExpressedIn rdf:resource="https://w3id.org/cdsg/resource/ca/Statute_c0d7710a"/>
        <cdsg:sourceStatementText xml:lang="en">designated groups means women, Aboriginal peoples, persons with disabilities and members of visible minorities; (groupes désignés)</cdsg:sourceStatementText>
        <rdfs:label xml:lang="en">Definition of designated groups, Employment Equity Act s. 3</rdfs:label>
