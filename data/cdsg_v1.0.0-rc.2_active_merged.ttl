        <https://w3id.org/cdsg/resource/temporal/TemporalQualification_b348f25cb2a7>,
        <https://w3id.org/cdsg/resource/ca/NormativeDocumentVersion_f9d70320_20240101>,
        <https://w3id.org/cdsg/resource/evidence/SourceEvidence_0edb1d7e> ;
    ana:assessmentReferenceDate "2026-08-27T00:00:00"^^xsd:dateTime ;
