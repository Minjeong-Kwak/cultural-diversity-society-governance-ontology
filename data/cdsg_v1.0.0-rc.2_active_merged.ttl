<https://w3id.org/cdsg/resource/evidence/SourceEvidence_356412d5> a cdsg:EvidenceRecord ;
    rdfs:label "Acquisition of nationality by naturalization, Nationality Act art. 4 - source evidence"@en,
        "국적법 제4조 귀화에 의한 국적 취득 출처근거"@ko ;
    cdsg:evidenceDocument <https://w3id.org/cdsg/resource/kr/Statute_9feedf13> ;
    cdsg:evidenceDocumentVersion <https://w3id.org/cdsg/resource/kr/NormativeDocumentVersion_9feedf13_20221001> ;
    cdsg:evidencePage "1" ;
    cdsg:evidenceSourceFileName "국적법(법률)(제18978호)(20221001).pdf" ;
    cdsg:evidenceText "제4조(귀화에 의한 국적 취득) ① 대한민국 국적을 취득한 사실이 없는 외국인은 법무부장관의 귀화허가(歸化許可)를 받아 대한민국 국적을 취득할 수 있다. ② 법무부장관은 귀화허가 신청을 받으면 제5조부터 제7조까지의 귀화 요건을 갖추었는지를 심사한 후 그 요건을 갖춘 사람에게만 귀화를 허가한다.<개정 2017. 12. 19.>"@ko ;
    cdsg:sourceLocator "제4조" .

<https://w3id.org/cdsg/resource/evidence/SourceEvidence_3ad6b3f3> a cdsg:EvidenceRecord ;
    rdfs:label "Federal Statistical Office definition of immigration history - source evidence"@en ;
