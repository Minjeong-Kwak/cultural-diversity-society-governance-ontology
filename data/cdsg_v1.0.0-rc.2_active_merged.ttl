    skos:note "Search scope: the source and policy documents collected in the project corpus at the reference date."@en ;
    ana:assessesCuratedCategory <https://w3id.org/cdsg/resource/uk/CommunityTarget_46262822> ;
    ana:assessmentReferenceDate "2026-08-27T00:00:00"^^xsd:dateTime ;
    ana:sourcingOutcome <https://w3id.org/cdsg/vocab#sourcing-outcome/no-source-statement-identified> .

<https://w3id.org/cdsg/resource/assessment/sourcing-069e0f4f> a ana:TargetCategorySourcingAssessment ;
    rdfs:label "Sourcing assessment of Canadian federal public-service system"@en ;
    skos:note "Search scope: the source and policy documents collected in the project corpus at the reference date."@en ;
    ana:assessesCuratedCategory <https://w3id.org/cdsg/resource/ca/PublicServiceSystemTarget_c551e02c> ;
    ana:assessmentReferenceDate "2026-08-27T00:00:00"^^xsd:dateTime ;
