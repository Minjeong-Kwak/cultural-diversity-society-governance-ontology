<https://w3id.org/cdsg/resource/assessment/sourcing-0488a592> a ana:TargetCategorySourcingAssessment ;
    rdfs:label "Sourcing assessment of ehemalige afghanische Ortskräfte und ihre Familienangehörigen"@en ;
    skos:note "Search scope: the source and policy documents collected in the project corpus at the reference date."@en ;
    ana:assessesCuratedCategory <https://w3id.org/cdsg/resource/de/RefugeeOrAsylumSeekerPopulation_7c21df03> ;
    ana:assessmentReferenceDate "2026-08-27T00:00:00"^^xsd:dateTime ;
