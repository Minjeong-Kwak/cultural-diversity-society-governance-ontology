<https://w3id.org/cdsg/vocab/> a owl:Ontology ;
    dcterms:description "Release candidate 2 controlled-vocabulary module containing SKOS concepts used for analytical classification rather than ontological identity."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-12"^^xsd:date ;
    dcterms:title "CDSG controlled vocabularies"@en ;
    owl:versionIRI <https://w3id.org/cdsg/vocab/1.0.0-rc.2> ;
    owl:versionInfo "1.0.0-rc.2" .

vocab:DocumentVersionKindScheme a skos:ConceptScheme ;
    skos:definition "Kinds of published text state of a normative document."@en ;
    skos:prefLabel "document version kind scheme"@en .

vocab:SourceValidityStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Source validity status scheme"@en .

vocab:JurisdictionLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "Jurisdiction level scheme"@en .

vocab:TargetCategorySourcingOutcomeScheme a skos:ConceptScheme ;
    skos:prefLabel "Target category sourcing outcome scheme"@en .

vocab:TargetCategoryAlignmentRelationScheme a skos:ConceptScheme ;
    skos:prefLabel "Target category alignment relation scheme"@en .

vocab:InstitutionalActorTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Institutional actor type scheme"@en .

vocab:TargetCategoryFacetScheme a skos:ConceptScheme ;
    skos:prefLabel "Target category facet scheme"@en .

skos:Concept a owl:Class .

